{
  "name": "daimzap-theme",
  "version": "1.0.0",
  "private": true,
  "description": "Custom WooCommerce theme for DaimZap — auto parts catalog.",
  "scripts": {
    "dev": "tailwindcss -i ./assets/css/src/skins/graphite.css -o ./assets/css/skin-graphite.css --watch",
    "dev:terminal": "tailwindcss -i ./assets/css/src/skins/terminal.css -o ./assets/css/skin-terminal.css --watch",
    "build:graphite": "tailwindcss -i ./assets/css/src/skins/graphite.css -o ./assets/css/skin-graphite.css --minify",
    "build:terminal": "tailwindcss -i ./assets/css/src/skins/terminal.css -o ./assets/css/skin-terminal.css --minify",
    "build": "npm run build:graphite && npm run build:terminal"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "tailwindcss": "^4.3.3"
  }
}
