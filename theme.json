{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": false,
		"useRootPaddingAwareAlignments": false,
		"layout": {
			"contentSize": "760px",
			"wideSize": "1180px"
		},
		"color": {
			"custom": true,
			"customGradient": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"slug": "ink",
					"color": "#11161e",
					"name": "Графит"
				},
				{
					"slug": "ink-muted",
					"color": "#667283",
					"name": "Серый текст"
				},
				{
					"slug": "ink-line",
					"color": "#dde1e6",
					"name": "Линии"
				},
				{
					"slug": "ink-surface",
					"color": "#f6f7f9",
					"name": "Подложка"
				},
				{
					"slug": "signal",
					"color": "#c1121f",
					"name": "Акцент"
				},
				{
					"slug": "base",
					"color": "#ffffff",
					"name": "Белый"
				}
			]
		},
		"typography": {
			"customFontSize": false,
			"dropCap": false,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Основной",
					"fontFamily": "Inter, \"Segoe UI\", system-ui, -apple-system, Roboto, \"Helvetica Neue\", Arial, sans-serif"
				},
				{
					"slug": "mono",
					"name": "Артикул",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace"
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"size": "0.8125rem",
					"name": "Мелкий"
				},
				{
					"slug": "medium",
					"size": "0.9375rem",
					"name": "Обычный"
				},
				{
					"slug": "large",
					"size": "1.25rem",
					"name": "Крупный"
				},
				{
					"slug": "x-large",
					"size": "1.75rem",
					"name": "Заголовок"
				}
			]
		},
		"spacing": {
			"units": [
				"px",
				"rem",
				"%"
			],
			"padding": true,
			"margin": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--color-surface-page, #ffffff)",
			"text": "var(--color-text-base, #1d2531)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--color-accent, #c1121f)"
				}
			}
		}
	}
}
